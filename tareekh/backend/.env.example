# Hindsight: local Docker (scripts/start_hindsight.sh). No API key needed locally.
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=chamber-memory

# Reasoning LLM. With LLM_PROVIDER=vertex the base URL and key below are ignored.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=google/gemini-3.8-flash

# OCR model (vision). Defaults to the same provider as above.
VISION_MODEL=google/gemini-3.8-flash
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# VISION_API_KEY=

# Pin "today" to the synthetic data's demo day. Leave empty for the real date.
TODAY=2026-10-05
AUTO_CONFIRM_THRESHOLD=0.8
HINDSIGHT_LLM_PROVIDER=vertexai
HINDSIGHT_LLM_MODEL=gemini-3.8-flash
LLM_PROVIDER=vertex
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=global
